---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import ButtonMotion from "@/components/interactive/ButtonMotion.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import close from "@/assets/icons/close.svg";
import play from "@/assets/icons/play.svg";
import pause from "@/assets/icons/pause.svg";
import { slotContent } from "@/utils/slots.ts";

type Emphasis = "primary" | "secondary";

type Tag =
  | (HTMLAttributes<"button"> & {
      /** Rendered element. */
      element?: "button";
      /** Native button type. */
      type?: "button" | "submit" | "reset";
      /** Disable the button. */
      disabled?: boolean;
      href?: never;
    })
  | (Omit<HTMLAttributes<"a">, "type"> & {
      element: "link";
      /** Link destination. */
      href?: string;
      type?: never;
      disabled?: never;
    });

type Kind =
  | {
      /** Button type. */
      variant?: "main";
      /** Visual emphasis. */
      emphasis?: Emphasis;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "link";
      /** A link carries no weight of its own: it is already the quietest. */
      emphasis?: never;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "play";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Play` or `Pause`. */
      label?: string;
      /** Show the pause icon and pressed state. */
      pressed?: boolean;
      direction?: never;
    }
  | {
      variant: "close";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Close`. */
      label?: string;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "arrow";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Next` or `Previous`. */
      label?: string;
      pressed?: never;
      /** Arrow direction. */
      direction?: "forward" | "back";
    };

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
} & Tag &
  Kind;

type AllProps = HTMLAttributes<"button"> &
  Omit<HTMLAttributes<"a">, "type"> & {
    render?: boolean;
    variant?: "main" | "link" | "play" | "close" | "arrow";
    emphasis?: Emphasis;
    label?: string;
    pressed?: boolean;
    direction?: "forward" | "back";
    element?: "button" | "link";
    href?: string;
    type?: "button" | "submit" | "reset";
  };

const {
  render = true,
  variant = "main",
  emphasis = "primary",
  label,
  pressed = false,
  direction = "forward",
  element = "button",
  href,
  type = "button",
  class: className,
  ...rest
} = Astro.props as AllProps;

const isLink = element === "link";
const Tag = isLink ? "a" : "button";
const tagAttrs = isLink
  ? { href: href || "#" }
  : { type: type === "submit" ? undefined : type };

const marks = { play, close, arrow };
/* main and link are written, the rest are marks with a label. */
const isWritten = variant === "main" || variant === "link";
const content = isWritten ? await slotContent(Astro.slots) : "";

const named = {
  play: pressed ? "Pause" : "Play",
  close: "Close",
  arrow: direction === "back" ? "Previous" : "Next",
};
---

{
  render && (isWritten ? content : true) && (
    <Tag
      class:list={[
        "button_wrap",
        emphasis !== "primary" && emphasis,
        variant !== "main" && variant,
        variant === "arrow" && direction === "back" && "back",
        className,
      ]}
      aria-label={isWritten ? undefined : (label ?? named[variant])}
      aria-pressed={variant === "play" ? pressed : undefined}
      {...tagAttrs}
      {...rest}
    >
      <ButtonMotion>
      {isWritten && (
        <span class="button_text text-style-trim">
          <Fragment set:html={content} />
        </span>
      )}
      {variant === "play" && (
        <Fragment>
          <Icon class="button_mark button_play" src={play} variant="small" />
          <Icon class="button_mark button_pause" src={pause} variant="small" />
        </Fragment>
      )}
      {variant === "close" && (
        <Icon class="button_mark" src={marks.close} variant="small" />
      )}
      {variant === "arrow" && (
        <Icon class="button_mark" src={marks.arrow} variant="small" />
      )}
      </ButtonMotion>
    </Tag>
  )
}

<style is:global>
  @layer components {
    .button_wrap {
      --_button-motion-inset: calc(-1 * var(--border-width));
      position: relative;
      isolation: isolate;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 0.5em;
      padding: 0.75em 1.5em;
      background-color: var(--button-background);
      color: var(--button-text);
      border: var(--border-width) solid var(--button-border);
      border-radius: var(--radius-small);
      line-height: 1.2;
      font-weight: var(--primary-medium);
      text-decoration: none;
      text-align: center;
      transition: scale 350ms cubic-bezier(0.22, 1, 0.36, 1);
      &:active:not(:disabled, [aria-disabled="true"]) {
        scale: 0.97;
        transition-duration: 120ms;
      }
      &.secondary {
        --button-background: var(--button-2-background);
        --button-text: var(--button-2-text);
        --button-border: var(--button-2-border);
        --button-background-hover: var(--button-2-background-hover);
        --button-text-hover: var(--button-2-text-hover);
        --button-border-hover: var(--button-2-border-hover);
      }
      &.link {
        --_button-motion-inset: 0;
        --button-background-between: transparent;
        --button-background: transparent;
        --button-text: var(--link-text);
        --button-border: var(--link-border);
        --button-background-hover: transparent;
        --button-text-hover: var(--link-text-hover);
        --button-border-hover: var(--link-border);

        padding: 0.4em 0;
        border: 0;
        border-bottom: var(--border-width) solid var(--button-border);
        border-radius: 0;
        &::after {
          content: "";
          position: absolute;
          inset-inline: 0;
          bottom: calc(-1 * var(--border-width));
          height: var(--border-width);
          background: var(--link-border-hover);
          transform: scaleX(0);
          transform-origin: right;
          transition: transform 340ms cubic-bezier(0.22, 1, 0.36, 1);
          pointer-events: none;
        }
        &:focus-visible:not(:disabled, [aria-disabled="true"])::after {
          transform: scaleX(1);
          transform-origin: left;
        }
        @media (hover: hover) and (pointer: fine) {
          &:hover:not(:disabled, [aria-disabled="true"])::after {
            transform: scaleX(1);
            transform-origin: left;
          }
        }
      }
      &:is(.play, .close, .arrow) {
        gap: 0;
        padding: 0.75em;
        border-radius: var(--radius-round);
      }
      &.arrow {
        border-radius: 0;
      }
      &.back .button_mark {
        rotate: 180deg;
      }
      &.play .button_pause {
        display: none;
      }
      &.play[aria-pressed="true"] {
        & .button_play {
          display: none;
        }
        & .button_pause {
          display: block;
        }
      }
      &:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }
      @media (prefers-reduced-motion: reduce) {
        transition: none;
        &:hover,
        &:active { scale: 1; }
      }
    }
  }
</style>
