---
import { slotContent } from "@/utils/slots.ts";
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}
const { render = true } = Astro.props;
const lead = await slotContent(Astro.slots, "lead");
const content = await slotContent(Astro.slots);
const credentials = await slotContent(Astro.slots, "credentials");
const visual = await slotContent(Astro.slots, "visual");
---

{render && lead && content && (
  <div class="hero-main_wrap">
    <div class="hero-main_body">
      <div class="hero-main_lead margin-trim" data-hero-copy><Fragment set:html={lead} /></div>
      <div class="hero-main_support margin-trim" data-hero-copy><Fragment set:html={content} /></div>
      {visual && <div class="hero-main_visual" data-hero-visual><div class="hero-main_artwork"><Fragment set:html={visual} /></div></div>}
      {credentials && <div class="hero-main_credentials" data-hero-copy><Fragment set:html={credentials} /></div>}
    </div>
  </div>
)}

<style is:global>
  @layer components {
    .hero-main_wrap {
      --_alignment: start;
      --hvac-height: calc((100vw + 3rem) * 7 / 9 + 16rem);
      --hvac-aspect: auto;
      position: relative;
      display: flex;
      flex: 1;
      width: 100%;
      overflow: clip;
      padding: var(--space-7) var(--site-margin);
      .hero-main_body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: var(--_alignment);
        gap: var(--space-5);
        width: 100%;
      }
      .hero-main_lead, .hero-main_support {
        display: flex;
        flex-direction: column;
        align-items: var(--_alignment);
        min-width: 0;
        max-width: 100%;
      }
      .hero-main_credentials {
        width: 100%;
        margin-top: var(--space-3);
      }
      .hero-main_lead, .hero-main_support, .hero-main_credentials {
        position: relative;
        z-index: 1;
        opacity: var(--hero-copy-opacity, 1);
        transform: translateY(var(--hero-copy-shift, 0rem));
      }
      .hero-main_visual { position: relative; min-width: 0; width: 100%; }
      .hero-main_artwork {
        opacity: var(--hero-scene-opacity, 1);
        width: calc(100% + 2 * var(--site-margin) + 3rem);
        margin-inline: calc(-1 * var(--site-margin) - 1.5rem);
        margin-block: -8rem;
      }
      @media (width >= 64rem) {
        --hvac-height: 100%;
        --hvac-aspect: auto;
        --hvac-intro-width: 0.7;
        --hvac-intro-center: 0.69;
        min-height: calc(100svh - var(--nav-height));
        padding-block: var(--space-5);
        .hero-main_body {
          isolation: isolate;
          display: grid;
          grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
          grid-template-rows: 1fr auto 1fr;
          column-gap: var(--space-4);
          row-gap: var(--space-5);
          align-items: center;
        }
        .hero-main_lead { grid-column: 1; grid-row: 1; align-self: end; }
        .hero-main_support { grid-column: 1; grid-row: 2; }
        .hero-main_credentials { grid-column: 1; grid-row: 3; align-self: start; margin-top: 0; }
        .hero-main_lead, .hero-main_support, .hero-main_credentials { z-index: 1; }
        .hero-main_visual { position: absolute; inset: 0; z-index: 0; }
        .hero-main_artwork {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          margin: 0;
        }
      }
    }
  }
</style>
