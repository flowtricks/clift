---
import type { HTMLAttributes } from "astro/types";
type Props = Omit<HTMLAttributes<"ol">, "type" | "start"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** List items. */
  items?: { title: string; text: string }[];
};
const { render = true, items = [], class: className, ...rest } = Astro.props;
const visibleItems = items.filter((item) => item.title?.trim());
---

{
  render && visibleItems.length > 0 && (
    <ol class:list={["principles-main_wrap", className]} {...rest}>
      {visibleItems.map(({ title, text }, i) => (
        <li class="principles-main_item">
          <span class="principles-main_number">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3 class="text-style-h6">{title}</h3>
            <p class="text-style-small">{text}</p>
          </div>
        </li>
      ))}
    </ol>
  )
}
<style is:global>
  @layer components {
    .principles-main_wrap {
      display: grid;
      gap: 0;
      margin-top: var(--space-6);
      .principles-main_item {
        border-top: var(--border-width) solid var(--border);
        padding-block: var(--space-4);
        display: grid;
        grid-template-columns: 2.625rem 1fr;
        gap: var(--space-3);
      }
      .principles-main_number {
        color: var(--accent-500);
        font-family: var(--h5-font-family);
        font-size: 1.2rem;
      }
      p {
        margin-top: var(--space-2);
        color: var(--text-2);
      }
    }
  }
</style>
